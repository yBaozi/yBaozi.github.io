---
interface Props {
  title: string
  list: Array<{
    name: string
    avatar: string
    desc: string
    url: string
  }>
}

const { title, list } = Astro.props;
const shuffle = <T>(arr: T[]): T[] => {
  const a = [...arr];
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
};
const data = shuffle(list);
---

<style>
  .friend-card-inner {
    box-shadow: none !important;
    text-shadow: none !important;
  }

  .friend-card-inner img {
    filter: none !important;
    box-shadow: none !important;
  }
</style>

{data.length > 0 && (
  <div class="mt-8">
    <h3 class="mb-4 text-lg font-semibold text-gray-800 dark:text-gray-100">{title}</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {data.map((item) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="friend-card-inner flex items-center gap-4 p-4 rounded-xl
                 bg-transparent
                 border border-gray-200 dark:border-[#27272a]
                 hover:border-[var(--accent)] hover:bg-[var(--accent)]/10
                 hover:-translate-y-1
                 transition duration-300 ease-out
                 text-gray-800 dark:text-gray-100 no-underline"
        >
          <img
            src={item.avatar}
            alt={item.name}
            class="w-14 h-14 rounded-lg object-cover"
          />
          <div class="min-w-0">
            <div class="font-medium truncate text-gray-800 dark:text-gray-100">{item.name}</div>
            <div class="text-sm truncate text-gray-500 dark:text-gray-400">{item.desc}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
)}
